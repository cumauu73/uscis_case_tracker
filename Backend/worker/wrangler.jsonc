{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mycaseupdates-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.mycaseupdates.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "USCIS_BASE_URL": "https://api-int.uscis.gov",
    "USCIS_CASE_STATUS_PATH_TEMPLATE": "/case-status/{receiptNumber}",
    "USCIS_SCOPE": "",
    "CACHE_TTL_SECONDS": "300",
    "FREE_CASE_LIMIT": "2",
    "PREMIUM_CASE_LIMIT": "10",
    "FREE_REFRESH_INTERVAL_MINUTES": "0",
    "PREMIUM_REFRESH_INTERVAL_MINUTES": "60",
    "MOCK_USCIS_RESPONSES": "true"
  }
}
